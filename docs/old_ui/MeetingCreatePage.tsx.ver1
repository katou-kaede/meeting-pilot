import { useState } from "react";
import { useNavigate, Link } from "react-router-dom";
import type { AgendaForm } from "../types/meeting";
import ErrorMessage from "../components/ErrorMessage";

export default function MeetingCreatePage() {
  // エラーメッセージ
  const [errorMessage, setErrorMessage] = useState("");

  // Meetings
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [targetName, setTargetName] = useState("");
  const [scheduledStartAt, setScheduledStartAt] = useState("");
  const [plannedMinutes, setPlannedMinutes] = useState("60");

  // Agendas
  const [agendas, setAgendas] =
    useState<AgendaForm[]>([
      {
        title: "",
        purpose: "",
        discussion_points: "",
        questions: "",
        memo: "",
        planned_minutes: "10",
      },
    ]);

  const navigate = useNavigate();
  const [openIndexes, setOpenIndexes] = useState<number[]>([0]);

  // 登録処理
  const handleSubmit = async () => {
    console.log(
      JSON.stringify(
        {
          title,
          target_name: targetName,
          description,
          scheduled_start_at: scheduledStartAt,
          planned_minutes: plannedMinutes,
          agendas,
        },
        null,
        2
      )
    );

    const response = await fetch("http://localhost:8080/api/meetings", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        title,
        description,
        target_name: targetName,
        scheduled_start_at: scheduledStartAt,
        planned_minutes: Number(plannedMinutes),

        agendas: agendas.map((agenda) => ({
          id: agenda.id,
          title: agenda.title,
          purpose: agenda.purpose,
          discussion_points: agenda.discussion_points,
          questions: agenda.questions,
          memo: agenda.memo,
          planned_minutes: Number(agenda.planned_minutes),
        }))
      })
    })

    if (response.ok) {
      navigate("/");
      return
    }

    const error = await response.json();
    setErrorMessage(error.error);
  }

  // アジェンダカード開閉
  const toggleAgenda = (index: number) => {
    setOpenIndexes((prev) =>
      prev.includes(index)
        ? prev.filter((i) => i !== index)
        : [...prev, index]
    );
  };

  // Agendaの合計時間の計算
  const totalMinutes = (agendas ?? []).reduce(
    (sum, agenda) => sum + Number(agenda.planned_minutes),
    0
  );

  return (
    <div className="bg-slate-50 min-h-screen">
      <div className="max-w-5xl mx-auto p-8">
        <Link
          to="/"
          className="text-slate-500 hover:text-slate-900"
        >
          ← 会議一覧へ戻る
        </Link>

        <div className="flex justify-between items-start my-6">
          <h1 className="text-3xl font-bold text-slate-900">
            会議新規作成
          </h1>
        </div>

        {/* エラーメッセージ */}
        {errorMessage && (
          <ErrorMessage message={errorMessage} />
        )}

        <div className="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 className="mb-4 text-lg font-semibold">会議情報</h2>

          {/* 会議作成フォーム */}
          <div className="space-y-4">
            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">会議名</label>
              <input
                type="text"
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                className="w-full border rounded-xl border-slate-300 px-3 py-2"
              />
            </div>

            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">会議詳細</label>
              <textarea
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                rows={4}
                className="w-full border rounded-xl border-slate-300 px-3 py-2"
              />
            </div>

            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">会議相手</label>
              <input
                type="text"
                value={targetName}
                onChange={(e) => setTargetName(e.target.value)}
                className="w-full border rounded-xl border-slate-300 px-3 py-2"
              />
            </div>

            <div className="flex gap-4">
              <div>
                <label className="mb-1 block text-sm font-medium text-slate-700">開始日時</label>
                <input
                  type="datetime-local"
                  value={scheduledStartAt}
                  onChange={(e) => setScheduledStartAt(e.target.value)}
                  className="w-full border rounded-xl border-slate-300 px-3 py-2"
                />
              </div>

              <div>
                <label className="mb-1 block text-sm font-medium text-slate-700">予定時間(分)</label>
                <input
                  type="number"
                  value={plannedMinutes}
                  onChange={(e) =>
                    setPlannedMinutes(e.target.value)
                  }
                  className="w-full border border-slate-300 rounded-xl px-3 py-2"
                />
              </div>
            </div>
          </div>

          {/* アジェンダ作成フォーム */}
          <div className="mt-8">
            <div className="mb-4 flex items-center justify-between">
              <h2 className="text-xl font-semibold">
                アジェンダ
              </h2>
              
              <button
                type="button"
                onClick={() =>  {
                  setAgendas([
                    ...agendas,
                    { 
                      title: "",
                      purpose: "",
                      discussion_points: "",
                      questions: "",
                      memo: "",
                      planned_minutes: "10",
                    },
                  ]);

                  setOpenIndexes([
                    ...openIndexes,
                    agendas.length,
                  ]);
                }}
                className="rounded-xl bg-slate-900 px-4 py-2 text-white"
              >
                + 議題追加
              </button>
            </div>

            {agendas.map((agenda, index) => (
              <div
                key={index}
                className="mb-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
              >
                {/* ヘッダー */}
                <div className="flex items-center justify-betwee">
                  <div
                    className="flex flex-1 cursor-pointer"
                    onClick={() => toggleAgenda(index)}
                  >
                    <h3 className="font-semibold">
                      議題 {index + 1}
                    </h3>

                    {agenda.title && (
                      <p className=" text-slate-500 mx-5">
                        {agenda.title}
                      </p>
                    )}
                  </div>

                  <div className="flex items-center gap-4">
                    {agendas.length > 1 && (
                      <button
                        type="button"
                        onClick={() => {
                          setAgendas(
                            agendas.filter((_, i) => i !== index)
                          );
                        }}
                        className="text-sm text-red-600 hover:text-red-700"
                      >
                        削除
                      </button>
                    )}

                    <button
                      type="button"
                      onClick={() => toggleAgenda(index)}
                      className="text-slate-500"
                    >
                      {openIndexes.includes(index) ? "⌄" : "›"}
                    </button>
                  </div>
                </div>

                {openIndexes.includes(index) && (
                  <div className="border-t border-slate-200 mt-6">
                    {/* タイトル */}
                    <div className="my-4">
                      <label className="mb-1 block text-sm font-medium text-slate-700">
                        タイトル
                      </label>

                      <input
                        type="text"
                        value={agenda.title}
                        placeholder={`議題${index + 1}`}
                        onChange={(e) => {
                          const updated = [...agendas];
                          updated[index].title = e.target.value;
                          setAgendas(updated);
                        }}
                        className="w-full rounded-xl border border-slate-300 px-3 py-2"
                      />
                    </div>

                    {/* 目的 */}
                    <div className="mb-4">
                      <label className="mb-1 block text-sm font-medium text-slate-700">
                        目的
                      </label>

                      <textarea
                        value={agenda.purpose}
                        onChange={(e) => {
                          const updated = [...agendas];
                          updated[index].purpose = e.target.value;
                          setAgendas(updated);
                        }}
                        rows={2}
                        className="w-full border border-slate-300 rounded-xl px-3 py-2"
                      />
                    </div>

                    {/* 議論ポイント */}
                    <div className="mb-4">
                      <label className="mb-1 block text-sm font-medium text-slate-700">
                        議論ポイント
                      </label>

                      <textarea
                        value={agenda.discussion_points}
                        onChange={(e) => {
                          const updated = [...agendas];
                          updated[index].discussion_points =
                            e.target.value;
                          setAgendas(updated);
                        }}
                        rows={3}
                        className="w-full border border-slate-300 rounded-xl px-3 py-2"
                      />
                    </div>

                    {/* 質問 */}
                    <div className="mb-4">
                      <label className="block mb-1 text-sm font-medium text-slate-700">
                        質問
                      </label>

                      <textarea
                        value={agenda.questions}
                        onChange={(e) => {
                          const updated = [...agendas];
                          updated[index].questions = e.target.value;
                          setAgendas(updated);
                        }}
                        rows={3}
                        className="w-full rounded-xl border border-slate-300 px-3 py-2"
                      />
                    </div>

                    {/* メモ */}
                    <div className="mb-4">
                      <label className="block mb-1 text-sm font-medium text-slate-700">
                        メモ  </label>

                      <textarea
                        value={agenda.memo}
                        onChange={(e) => {
                        const updated = [...agendas];
                        updated[index].memo = e.target.value;
                        setAgendas(updated);
                        }}
                        rows={3}
                        className="w-full rounded-xl border border-slate-300 px-3 py-2"
                      />
                    </div>

                    {/* 予定時間 */}
                    <div>
                      <label className="mb-1 block text-sm font-medium text-slate-700">
                        予定時間（分）
                      </label>

                      <input
                        type="number"
                        value={agenda.planned_minutes}
                        onChange={(e) => {
                          const updated = [...agendas];
                          updated[index].planned_minutes =
                            e.target.value;
                          setAgendas(updated);
                        }}
                        className="w-32 border border-slate-300 rounded-xl px-3 py-2"
                      />
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>

          <div className="my-6 pt-4 border-t border-slate-200 flex justify-between font-semibold">
            <span>アジェンダ合計</span>
            <span>{totalMinutes}分</span>
          </div>

          <button
            onClick={handleSubmit}
            className="rounded-xl bg-blue-600 px-8 py-3 font-medium text-white hover:bg-blue-700"
          >
            保存
          </button>
        </div>
      </div>
    </div>
  );
}